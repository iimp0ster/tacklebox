{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iimp0ster/tacklebox/schema/tacklebox-rig.schema.json",
  "title": "Tacklebox Rig",
  "description": "Schema for a kit-profile (rig) YAML file. Chains atomics in execution order with token-state dependencies between steps. Field names are draft until Section 9.3 bikeshed is resolved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rig", "steps"],
  "properties": {
    "rig": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase identifier for the rig (matches filename without .yaml)."
    },
    "display_name": { "type": "string" },
    "description": { "type": "string" },
    "ua_profile": { "type": "string" },
    "egress_profile": {
      "enum": ["direct", "residential", "datacenter", "tor"]
    },
    "stop_on_error": { "type": "boolean" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atomic"],
      "properties": {
        "atomic": { "type": "string" },
        "test_name": { "type": "string" },
        "args": {
          "type": "object",
          "additionalProperties": true
        },
        "requires_token_from": { "type": "string" }
      }
    }
  }
}
