{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iimp0ster/tacklebox/schema/tacklebox-atomic.schema.json",
  "title": "Tacklebox Atomic",
  "description": "Schema for an atomic YAML file. Atomic Red Team-compatible base + 5 Tacklebox extensions (auth_profile, defense_evasion, requires_token, expected_telemetry, exercises_chokepoint). Field names in this version are draft and subject to the Section 9.3 bikeshed; do not author atomics against this schema until Phase 0 exit criteria confirm the names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["attack_technique", "atomic_tests"],
  "properties": {
    "attack_technique": {
      "type": "string",
      "pattern": "^T\\d{4}(\\.\\d{3})?$",
      "description": "MITRE ATT&CK technique ID."
    },
    "display_name": { "type": "string" },
    "atomic_tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/atomic_test" }
    }
  },
  "$defs": {
    "atomic_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "auto_generated_guid", "executor"],
      "properties": {
        "name": { "type": "string" },
        "auto_generated_guid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "description": { "type": "string" },
        "supported_platforms": {
          "type": "array",
          "items": { "enum": ["windows", "linux", "macos"] },
          "minItems": 1
        },
        "input_arguments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/input_argument" }
        },
        "executor": { "$ref": "#/$defs/executor" },
        "cleanup_command": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" } },

        "auth_profile": { "type": "string" },
        "defense_evasion": { "type": "string" },
        "requires_token": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string" },
                "resource": { "type": "string" }
              },
              "required": ["from"]
            }
          ]
        },
        "expected_telemetry": {
          "type": "array",
          "items": { "$ref": "#/$defs/telemetry_expectation" }
        },
        "exercises_chokepoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "input_argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "description": { "type": "string" },
        "type": { "enum": ["String", "Integer", "Path", "Url", "Boolean"] },
        "default": {}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": { "enum": ["powershell", "sh", "bash"] },
        "command": { "type": "string" },
        "elevation_required": { "type": "boolean" }
      }
    },
    "telemetry_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "match"],
      "properties": {
        "source": { "enum": ["entra_signin", "ual", "graph_audit", "exo_audit"] },
        "match": {
          "type": "object",
          "minProperties": 1
        },
        "within_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        }
      }
    }
  }
}
